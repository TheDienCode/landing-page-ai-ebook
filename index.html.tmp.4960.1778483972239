function toggleFaq(i) {
  const items = document.querySelectorAll('.faq-item');
  const clicked = document.getElementById(`faq-${i}`);
  const body = clicked.querySelector('.faq-body');
  const isOpen = clicked.classList.contains('open');

  items.forEach(el => {
    el.classList.remove('open');
    el.querySelector('.faq-body').classList.remove('open');
    el.style.borderColor = '#1a3055';
  });

  if (!isOpen) {
    clicked.classList.add('open');
    body.classList.add('open');
    clicked.style.borderColor = '#2563eb';
  }
}

// Countdown
function startCountdown() {
  let deadline = localStorage.getItem('lpai_deadline');
  if (!deadline) {
    const d = new Date();
    d.setDate(d.getDate() + 7);
    d.setHours(23,59,59,999);
    deadline = d.toISOString();
    localStorage.setItem('lpai_deadline', deadline);
  }
  deadline = new Date(deadline);

  function tick() {
    const diff = deadline - new Date();
    if (diff <= 0) {
      ['days','hours','minutes','seconds'].forEach(id => document.getElementById(id).textContent = '00');
      return;
    }
    document.getElementById('days').textContent    = String(Math.floor(diff/86400000)).padStart(2,'0');
    document.getElementById('hours').textContent   = String(Math.floor(diff%86400000/3600000)).padStart(2,'0');
    document.getElementById('minutes').textContent = String(Math.floor(diff%3600000/60000)).padStart(2,'0');
    document.getElementById('seconds').textContent = String(Math.floor(diff%60000/1000)).padStart(2,'0');
  }
  tick();
  setInterval(tick, 1000);
}
startCountdown();

// Scroll reveal
const revealObs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('vis'); });
}, { threshold: 0.08 });
document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

// Progress bars animate
const pbObs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.querySelectorAll('.progress-fill[data-target]').forEach(bar => {
        const pct = Math.round((parseInt(bar.dataset.target) / 30) * 100);
        setTimeout(() => { bar.style.width = pct + '%'; }, 300);
      });
    }
  });
}, { threshold: 0.2 });
document.querySelectorAll('#stack-list').forEach(el => pbObs.observe(el));

// Responsive: show nav links on desktop
if (window.innerWidth >= 768) {
  document.querySelector('.nav-links').style.display = 'flex';
  document.querySelector('.nav-links').style.alignItems = 'center';
}

// Responsive: show phase emoji on wider screens
if (window.innerWidth >= 640) {
  document.querySelectorAll('.phase-emoji').forEach(el => el.style.display = 'block');
}

// Responsive: reason grid single col on mobile
if (window.innerWidth < 768) {
  const grid = document.getElementById('reason-grid');
  if (grid) { grid.style.gridTemplateColumns = '1fr'; }
  const statsRow = document.getElementById('stats-row');
  if (statsRow) { statsRow.style.gridTemplateColumns = 'repeat(2,1fr)'; }
}

</script>
